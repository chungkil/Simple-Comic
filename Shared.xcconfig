// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974
ALWAYS_SEARCH_USER_PATHS = NO
FRAMEWORK_SEARCH_PATHS = ${SRCROOT}/Carthage/Build/Mac ${SRCROOT}/../Carthage/Build/Mac

// Git-tag-driven version (regenerated by Scripts/set_version.sh as a build pre-action).
// Optional include: a fresh checkout has no generated file until the first build.
#include? "Config/Version.generated.xcconfig"

// Local code-signing Team ID — kept out of the public repo.
// Copy Config/DeveloperSettings.xcconfig.example to Config/DeveloperSettings.xcconfig.
#include? "Config/DeveloperSettings.xcconfig"
